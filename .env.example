# Documentation only. SafeFix reads process environment; this file is not auto-loaded.
SAFEFIX_PROVIDER=nebius
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Copy exact available model IDs from your Token Factory catalog.
SAFEFIX_PLANNER_MODEL=
SAFEFIX_REPAIR_MODEL=
# Enter TOKEN_FACTORY_API_KEY securely in the terminal or hosting secret store.
# Enable only on an isolated worker with Docker and dependency-network access:
SAFEFIX_AUTO_PREPARE=0
